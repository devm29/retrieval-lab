# Copy to .env. Every setting has a working default for local offline development.

# Database (scripts/local-pg.sh or docker compose expose Postgres + pgvector on 5502)
RLAB_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5502/retrieval_lab
RLAB_TEST_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5502/retrieval_lab_test

# LLM provider: "fake" runs fully offline and deterministically; "anthropic" calls Claude.
RLAB_LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
RLAB_GENERATION_MODEL=claude-opus-5-5
RLAB_JUDGE_MODEL=claude-sonnet-5-5
# Offline runs report what their tokens would cost on this model.
RLAB_COST_REFERENCE_MODEL=claude-sonnet-5-5

# Embeddings and reranking. "fastembed" runs ONNX models locally (downloaded once to .local/models);
# "hashing" and "lexical" need no downloads and are used by the test suite.
RLAB_EMBEDDER=fastembed
RLAB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RLAB_RERANKER=fastembed
RLAB_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

RLAB_CHUNK_SIZE=900
RLAB_CHUNK_OVERLAP=150
RLAB_EVAL_CONCURRENCY=4

# Optional. When set, POST/PATCH requests (the ones that spend Claude tokens in live mode) need
# `Authorization: Bearer <token>`; the Next.js proxy adds it for the dashboard.
RLAB_API_TOKEN=
RLAB_MAX_ACTIVE_RUNS=2
RLAB_CORS_ORIGINS=["http://localhost:3102","http://127.0.0.1:3102"]
RLAB_LOG_LEVEL=INFO
RLAB_LOG_JSON=false

# Web: where the Next.js server proxies /api requests
RLAB_API_URL=http://127.0.0.1:8102
